__pycache__/
.venv

reports/

vuln-api/coverage.xml
frontend/coverage/
frontend/node_modules/
certbot/*
.idea/

# Entornos virtuales y credenciales
.env

# Certificados TLS: se generan al desplegar (iniciar_app.sh con openssl),
# nunca deben versionarse. Una llave privada en git es una fuga de credenciales.
nginx/ssl/*.key
nginx/ssl/*.crt

# Certificados TLS de la base de datos (mismo motivo: NO versionar llaves privadas).
# Se generan con generate-db-ssl.sh en el host de la BD antes de desplegar.
db-ssl/*.key
db-ssl/*.crt
db-ssl/*.csr
db-ssl/*.srl
