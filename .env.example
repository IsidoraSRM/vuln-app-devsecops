VITE_API_URL=/api
# VITE_API_URL=http://localhost:8000

# ==========================================
# Configuración de Base de Datos
# ==========================================
POSTGRES_DB=vulnerabilidades_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password_seguro
# POSTGRES_HOST=db-api 
# POSTGRES_PORT=5432

# URL de conexión directa (usada para despliegue distribuido con SSL obligatorio)
# DATABASE_URL=postgresql://admin:password_seguro@IP_DEL_PC_BD:5433/vulnerabilidades_db?sslmode=require

# ENFORCE_DB_SSL=true fuerza SSL en el host de la BD (producción). En dev/CI dejar sin definir.
# ENFORCE_DB_SSL=true

# ==========================================
# Configuración de la API y Seguridad
# ==========================================
# ENCRYPTION_KEY: llave Fernet para cifrar credenciales (ej. la contraseña de Wazuh).
# Generar con:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME

# SECRET_KEY: secreto para firmar los tokens JWT. Usa una cadena aleatoria larga.
# Generar con:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME

